# Where the API lives, read by the server at request time — not a NEXT_PUBLIC_
# variable, so one built image serves every environment (see src/lib/api.ts).
#
# `nx dev aze-client` falls back to the address below when this is unset. A
# production build does not: it refuses to start guessing, so a deployed client
# says what is missing instead of failing every page against localhost. Copy
# this file to .env if you run `nx start aze-client` locally.
AZE_API_URL="http://localhost:3030/api"
