# Postgres, started by the docker-compose.yml at the repo root: docker compose up -d
# These credentials match that compose file.
DATABASE_URL="postgresql://aze:aze_local_password@localhost:5432/aze?schema=public"

NODE_ENV="development"

# Replace both of these before running anywhere other than your machine.
API_KEY="your_api_key_here"
JWT_SECRET="your_jwt_secret_here"

# Serves the interactive API documentation at /api/docs. Unset means on
# everywhere except production, where the route describes more of the API than
# you may want to publish. Only the exact string "true" turns it on.
# API_DOCS="true"
