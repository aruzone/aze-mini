# Postgres, started by the docker-compose.yml at the repo root: docker compose up -d
# These credentials match that compose file.
DATABASE_URL="postgresql://aze:aze_local_password@localhost:5432/aze?schema=public"

# Redis, from the same compose file. The cache fails open: with this pointing
# nowhere the API still answers, it just asks Postgres every time.
REDIS_URL="redis://localhost:6379"

NODE_ENV="development"

# Replace both of these before the API will start at all. A value still in the
# your_..._here shape is refused on startup, so a copy of this file cannot boot
# untouched. DATABASE_URL above is a real local value and needs no editing.
API_KEY="your_api_key_here"
JWT_SECRET="your_jwt_secret_here"

# Which origins a browser may call the API from, comma separated. Unset, only
# the client a local clone starts is allowed. A deployment names its own here
# rather than editing any code. "*" allows every origin — see docs/deployment.md
# before you reach for it.
# CORS_ORIGIN="https://app.example.com,https://admin.example.com"

# What to believe about X-Forwarded-For. Login throttling counts failures per
# source address, and behind a proxy every request arrives from the proxy, so
# untrusted they all share one bucket. Trusting it blindly is worse: the header
# is caller-supplied. Set it to the number of proxies actually in front of the
# API — 1 for a single ingress or load balancer.
# TRUST_PROXY="1"

# Serves the interactive API documentation at /api/docs. Only the exact string
# "true" turns it on; unset means on everywhere except production.
# API_DOCS="true"

# How much the structured JSON logs say: fatal, error, warn, info, debug or
# trace. Unset means info. A value that is none of these is refused on startup.
# LOG_LEVEL="debug"

# Serves Prometheus metrics at /api/metrics. Only the exact string "true"
# turns it on; unset means off everywhere. It is on here so the e2e suite can
# assert it — leave it unset in a real deployment unless something scrapes it.

# --- Token lifecycle (ADR-0009) -------------------------------------------
# Access tokens are short-lived; a refresh session in Postgres is what keeps a
# User signed in. All three are seconds. Defaults: 900 (15 minutes), 30 days,
# and 7 days of inactivity.
# ACCESS_TOKEN_TTL_SECONDS="900"
# REFRESH_TOKEN_TTL_SECONDS="2592000"
# REFRESH_IDLE_TTL_SECONDS="604800"

# --- Throttling (ADR-0010) -------------------------------------------------
# The perimeter ceiling per source per minute, and the tighter ceiling for
# registrations alone. Both fail closed: when Redis cannot answer, throttled
# routes answer 503 instead of waving requests through.
# THROTTLE_PER_MINUTE="100"
# REGISTRATIONS_PER_MINUTE="5"

# --- Email flows (ADR-0011) ------------------------------------------------
# Where the verification and reset links point. Configured, never taken from
# the request's Host header. Defaults to the client a local clone starts.
# APP_ORIGIN="https://app.example.com"

# Outbound mail over plain SMTP. Unset — or anywhere outside production — and
# the mail is written into the JSON log instead, so local development needs no
# SMTP server: the token is on the console.
# SMTP_URL="smtp://user:password@mail.example.com:587"

# Reset and verification token lifetimes, in seconds. Defaults: 60 minutes
# for a reset, 24 hours for verification.
# EMAIL_RESET_TTL_SECONDS="3600"
# EMAIL_VERIFICATION_TTL_SECONDS="86400"
METRICS_ENABLED="true"
